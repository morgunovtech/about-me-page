/*
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  ! Access-Control-Allow-Origin

# about-me-page-cr2.pages.dev is Cloudflare's technical host for this Pages
# project and <hash|branch>.about-me-page-cr2.pages.dev are its previews; the
# site is published at https://s.morgunov.tech only, so search engines are told
# not to index any of them. Cloudflare's own noindex on previews loses to the
# «index, follow» of /*, hence the second rule. Both sit right after /* so `!`
# replaces that value and the rules below still apply. Function-generated
# routes (/notes, /sitemap.xml, /llms.txt) do not get _headers at all; the
# /notes pages name s.morgunov.tech as canonical.
https://:project.pages.dev/*
  ! X-Robots-Tag
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  ! X-Robots-Tag
  X-Robots-Tag: noindex

# /404 itself is a Function (functions/404.js → real 404 status) and sets its
# own noindex + Cache-Control there; _headers only reaches the static asset.
# A path that matches several rules inherits all of them, so a header the /*
# block already sets must be detached (`! Name`) before it gets another value.
/404.html
  ! X-Robots-Tag
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# /about is hidden until the owner rewrites it: the pages carry
# <meta name="robots" content="noindex">, so the header must say the same
# instead of inheriting «index, follow» from /*.
/about
  ! X-Robots-Tag
  X-Robots-Tag: noindex

/en/about
  ! X-Robots-Tag
  X-Robots-Tag: noindex

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/favicon.ico
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/site.webmanifest
  Cache-Control: public, max-age=86400

/ds/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Both are referenced with a content-hash ?v= (scripts/version-stamp.py),
# so like /ds/* they can be cached forever — a content change mints a new URL.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable

# LICENSE, NOTICE and fonts/OFL.txt are served on purpose (the MIT licence, the
# personal-content notice, the OFL that ships with IBM Plex). LICENSE and NOTICE
# have no extension, so Pages typed them application/octet-stream and, with
# nosniff above, a browser downloaded them instead of showing the text. OFL.txt
# already resolves to text/plain by its extension; the rule pins the intent.
/LICENSE
  Content-Type: text/plain; charset=utf-8

/NOTICE
  Content-Type: text/plain; charset=utf-8

/fonts/OFL.txt
  Content-Type: text/plain; charset=utf-8
