/*
  X-Robots-Tag: index, follow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  ! Access-Control-Allow-Origin

/404.html
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/favicon.ico
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/site.webmanifest
  Cache-Control: public, max-age=86400

/ds/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Both are referenced with a content-hash ?v= (scripts/version-stamp.py),
# so like /ds/* they can be cached forever — a content change mints a new URL.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable
